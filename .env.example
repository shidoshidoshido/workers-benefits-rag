# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git. Never prefix these with NEXT_PUBLIC_.

OPENAI_API_KEY=sk-...

# Upstash Vector — REST credentials from your index in the Upstash console.
# Create the index with dimension 1536 and cosine similarity (text-embedding-3-small).
UPSTASH_VECTOR_REST_URL=https://...-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=...

# Optional tuning knobs (defaults shown). Change in Vercel without touching code.
# TOP_K=5
# MIN_SCORE=0.2
